[
  {
    "label": "bats $ZED_FILENAME $ZED_CUSTOM_BATS_TEST_NAME",
    "command": "name=$(printenv ZED_CUSTOM_BATS_TEST_NAME); name=${name#[\\\"\\']}; name=${name%[\\\"\\']}\nexec bats --filter \"^$(printf %s \"$name\" | sed 's/[][\\\\.*+?^$|(){}]/\\\\&/g')\\$\" \"$(printenv ZED_FILE)\"",
    "shell": {
      "with_arguments": {
        "program": "bash",
        "args": [
          "--norc",
          "--noprofile"
        ]
      }
    },
    "save": "current",
    "show_command": false,
    "tags": [
      "bats-test"
    ]
  },
  {
    "label": "bats $ZED_FILENAME",
    "command": "exec bats \"$(printenv ZED_FILE)\"",
    "shell": {
      "with_arguments": {
        "program": "bash",
        "args": [
          "--norc",
          "--noprofile"
        ]
      }
    },
    "save": "current",
